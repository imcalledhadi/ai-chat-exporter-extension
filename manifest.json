{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "1.0.0",
  "description": "Export conversations from Claude, ChatGPT, Gemini, Grok, Meta AI & DeepSeek to PDF, Word, TXT, HTML, JSON",
  "author": "AI Chat Exporter",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AI Chat Exporter"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "options_page": "options/options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://x.com/*",
    "https://meta.ai/*",
    "https://*.meta.ai/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://copilot.microsoft.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://x.com/*",
        "https://meta.ai/*",
        "https://*.meta.ai/*",
        "https://deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content/parsers.js",
        "content/exporters.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["export/print-template.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
